#!/bin/sh
#
# Default parameters for a fully-actuated hexarotor.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

set VEHICLE_TYPE mc

param set-default CA_ROTOR_COUNT 6
param set-default MAV_TYPE 13 # Hexarotor
param set-default CA_AIRFRAME 9 # Custom Airframe
param set-default CA_METHOD 0 # Pseduo-inverse


if param compare IMU_GYRO_RATEMAX 400
then
	param set-default IMU_GYRO_RATEMAX 800
fi

param set-default NAV_ACC_RAD 2

param set-default RTL_RETURN_ALT 30
param set-default RTL_DESCEND_ALT 10

param set-default GPS_UBX_DYNMODEL 6

# lower RNG_FOG since MC are expected to fly closer over obstacles
param set-default EKF2_RNG_FOG 1.0
